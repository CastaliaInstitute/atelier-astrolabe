# LunaSay uses USB as a local PWA network tether. Keep TinyUSB free of the
# fixed USB Serial/JTAG console, but expose a TinyUSB CDC console alongside NCM.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
# CONFIG_TINYUSB_MSC_ENABLED is not set
# CONFIG_TINYUSB_NET_MODE_NONE is not set
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_HID_COUNT=0
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
