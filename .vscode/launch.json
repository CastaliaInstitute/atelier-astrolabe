    {
      "name": "Astrolabe JTAG (no upload)",
      "type": "platformio-debug",
      "request": "launch",
      "executable": "${workspaceFolder}/.pio/build/waveshare_s3_175_debug/firmware.elf",
      "projectEnvName": "waveshare_s3_175_debug",
      "toolchainBinDir": "${env:HOME}/.platformio/packages/toolchain-xtensa-esp32s3@8.4.0+2021r2-patch5/bin",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
