# ASTROLABE185B USB flash profile (ASTROLABE185B_USB_MODE=msc).
#
# faculty175_usb.c uses the esp_tinyusb MSC storage API, so the MSC class must
# be enabled; the CDC/NCM network class (which app-demands tud_network_recv_cb)
# stays off, mirroring the 175c-idiomatic sdkconfig state.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_MSC_MOUNT_PATH="/data"
CONFIG_TINYUSB_NET_MODE_NONE=y
# CONFIG_TINYUSB_NET_MODE_NCM is not set
# CONFIG_TINYUSB_NET_MODE_ECM_RNDIS is not set
