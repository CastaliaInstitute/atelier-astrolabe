# USB Audio Class gadget (waveshare_s3_175_uac env only)
CONFIG_ARDUINO_LOOP_STACK_SIZE=24576
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_MIC_CHANNEL_NUM=0
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_SUPPORT_MACOS=y
CONFIG_UAC_TUSB_MANUFACTURER="Castalia Institute"
CONFIG_UAC_TUSB_PRODUCT="Astrolabe UAC"
CONFIG_UAC_TUSB_SERIAL_NUM="astrolabe-uac"
