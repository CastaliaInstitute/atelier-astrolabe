    {"id": "conversation_full_wifi", "scenario": "full-wifi", "workload": "conversation", "display": "100%", "radio": "wifi", "duration_min": 10080, "capture_ms": 7000, "minimum_successful_turns": 10},
    {"id": "conversation_dim_wifi", "scenario": "dim-wifi", "workload": "conversation", "display": "10%", "radio": "wifi", "duration_min": 10080, "capture_ms": 7000, "minimum_successful_turns": 10},
    {"id": "conversation_off_wifi", "scenario": "off-wifi", "workload": "conversation", "display": "off", "radio": "wifi", "duration_min": 10080, "capture_ms": 7000, "minimum_successful_turns": 10},
    {"id": "journal_off_wifi", "scenario": "off-wifi", "workload": "journal", "display": "off", "radio": "wifi", "duration_min": 10080, "capture_ms": 30000, "journal_gap_s": 0, "minimum_successful_turns": 10, "minimum_capture_coverage_ratio": 0.75},
    {"id": "true_deep_sleep", "runner": "deep-sleep", "display": "rails-off", "radio": "off", "duration_min": 720, "release_basis": "direct-projection"}
