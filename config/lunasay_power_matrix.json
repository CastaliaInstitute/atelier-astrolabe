    {"id": "full_ble_idle", "scenario": "full-offline", "workload": "ble", "display": "100%", "radio": "ble", "duration_min": 10080},
    {"id": "dim_wifi_idle", "scenario": "dim-wifi", "workload": "idle", "display": "10%", "radio": "wifi", "duration_min": 10080},
    {"id": "dim_offline_idle", "scenario": "dim-offline", "workload": "idle", "display": "10%", "radio": "off", "duration_min": 10080},
    {"id": "dim_ble_idle", "scenario": "dim-offline", "workload": "ble", "display": "10%", "radio": "ble", "duration_min": 10080},
    {"id": "off_wifi_idle", "scenario": "off-wifi", "workload": "idle", "display": "off", "radio": "wifi", "duration_min": 10080},
    {"id": "off_offline_idle", "scenario": "sleep-offline", "workload": "idle", "display": "off", "radio": "off", "duration_min": 10080},
    {"id": "off_ble_idle", "scenario": "sleep-offline", "workload": "ble", "display": "off", "radio": "ble", "duration_min": 10080},
