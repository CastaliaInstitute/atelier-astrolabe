# Publish static site from docs/. Repo Settings → Pages → Source: GitHub Actions.

name: Deploy GitHub Pages

on:
  push:
    branches: [main]
    paths:
      - "docs/**"
      - ".github/workflows/deploy-github-pages.yml"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages-deploy
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Inject Supabase config for voice
        run: |
          cat > docs/config.local.js <<'EOF'
          window.__CASTALIA_CONFIG__ = {
            supabaseUrl: "${{ secrets.MYNAH_SUPABASE_URL }}",
            supabaseAnonKey: "${{ secrets.MYNAH_SUPABASE_ANON_KEY }}",
            castaliaWebOrigin: "https://castalia.institute",
          };
          EOF

      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: docs
      - uses: actions/deploy-pages@v4
        id: deployment
